\f0\fs24 \cf0 /*\
  \uc0\u23560 \u26696 \u65306 \u32654 \u26989 \u32887 \u20154 \u25928 \u29575 \u38761 \u21629  - \u26234 \u24935 \u22411 \u33258 \u21205 \u35722 \u33394 \u35336 \u26178 \u22120 \
  \uc0\u21151 \u33021 \u65306 \
  1. \uc0\u33258 \u21205 \u20597 \u28204 \u30070 \u21069 \u26085 \u26399 \u65292 \u20999 \u25563 \u19977 \u20491 \u19981 \u21516 \u27874 \u27573 \u30340 \u25130 \u27490 \u26178 \u38291 \u12290 \
  2. \uc0\u30070 \u36317 \u38626 \u25130 \u27490 \u26178 \u38291 \u23567 \u26044  24 \u23567 \u26178 \u26178 \u65292 \u25991 \u23383 \u33258 \u21205 \u35722 \u26356 \u28858 \u12300 \u35686 \u31034 \u32005 \u12301 \u20006 \u22686 \u21152 \u30332 \u20809 \u25928 \u26524 \u12290 \
  3. \uc0\u20498 \u25976 \u32080 \u26463 \u24460 \u33258 \u21205 \u25509 \u26834 \u33267 \u19979 \u19968 \u22580 \u27425 \u12290 \
